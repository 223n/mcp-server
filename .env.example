# Copy this file to .env and fill in values for your environment.
# docker-compose.yml が必要な値だけをコンテナーに渡します。
OLLAMA_URL=http://host.docker.internal:11434
DEFAULT_MODEL=nucbox-fast:latest
DEEP_MODEL=qwen2.5-coder:14b

# Ollama から何も届かない状態の上限（ミリ秒）。キュー待ち、モデル読み込み、プロンプト評価の時間も含む
OLLAMA_TIMEOUT=300000
# 1 回の生成全体の上限（ミリ秒）。既定は 3000 秒。
# claude.ai のコネクタは約 240 秒、Cloudflare は無通信が約 100 秒で打ち切るため、
# リモートで主に使うなら 200000 ほどに下げると、打ち切られる前に途中までの結果を返せる
OLLAMA_MAX_DURATION=3000000

# HTTP の要求を受け取り終えるまでの上限（ミリ秒）。既定は 60 秒。
# 応答を返している時間（生成の時間）には効かないため、長い生成のために上げる必要はない。
# 上げると、本文をゆっくり送り続ける相手に接続をその間つかまれる
# HTTP_REQUEST_TIMEOUT=60000

# 同時に走らせる生成の数と、待ち行列の長さの上限。
# Ollama は GPU を 1 つずつ使うため、並べても全体は速くならない。
# 待ち行列も一杯のときは、待たせずにその場で断る
# OLLAMA_MAX_CONCURRENCY=2
# OLLAMA_MAX_QUEUE=8

# HTTP で受け付ける Host / Origin（カンマ区切り）
# ALLOWED_HOSTS=localhost,127.0.0.1,[::1],host.docker.internal,mcp.223n.tech

# HTTP 経由でもファイル読み込みツール（files 引数と list_files）を許可する場合だけ true（既定は stdio のみ）。
# 下の認証（MCP_AUTH_TOKEN か CF_ACCESS_*）を設定していないときは無視する
# HTTP_ALLOW_FILES=false

# ローカルのモデルの出力をファイルに書き出す先（ホスト側パス=コンテナー内パス、1 件だけ）。
# 設定したときだけ save_output と output_name の引数が出る。空なら保存の機能ごと無効。
# ディレクトリは先にホスト側で作り、コンテナーの node ユーザーが書ける権限にしておく
# OUTPUT_DIR=C:\dev\ollama-out=/work/dev/ollama-out

# HTTP 経由でも保存を許す場合だけ true（既定は stdio のみ）。
# HTTP_ALLOW_FILES とは別に持つ。読み込みを許しただけの設定が、更新で黙って書き込みに広がらないようにするため。
# 下の認証を設定していないときは無視する
# HTTP_ALLOW_WRITES=false

# リポジトリを取得する先（ホスト側パス=コンテナー内パス、1 件だけ）。
# サーバーが書き換えてよいのはここの配下だけで、FILE_ROOTS には書かない。
# C:\dev 全体ではなく専用のサブディレクトリにして、既存のプロジェクトを触らせない
# CLONE_ROOT=C:\dev\claude=/work/dev/claude

# 取得してよい GitHub の owner（カンマ区切り）。空なら取得そのものを拒む
# GIT_ALLOWED_OWNERS=223n

# commit と push を許す場合だけ true。stdio でだけ効き、HTTP では常に無効
# GIT_ALLOW_WRITE=false

# commit に使う名前とメールアドレス。commit するなら両方とも要る
# GIT_USER_NAME=223n
# GIT_USER_EMAIL=223n@223n.tech

# GitHub の API のトークン。fine-grained を使い、対象のリポジトリを列挙する。
# GITHUB_TOKEN という名前にしないのは、CI やシェルにたまたま存在することが多く、
# ホストで直に起動したときに無関係のトークンで GitHub のツールが有効になるため
# GITHUB_MCP_TOKEN=

# PR の作成とコメントを許す場合だけ true。stdio でだけ効き、HTTP では常に無効
# GITHUB_ALLOW_WRITE=false

# HTTP の認証（どちらかを設定すると、満たさないリクエストは 401）
# 静的トークン: Authorization: Bearer <MCP_AUTH_TOKEN>
# MCP_AUTH_TOKEN=
# Cloudflare Access の JWT（Cf-Access-Jwt-Assertion）を検証する
# CF_ACCESS_TEAM_DOMAIN=223n.cloudflareaccess.com
# CF_ACCESS_AUD=46e64965fee521bbce471b323fdb211c353f2ad9d630e6ab12a9023fe29e8eb2
# Access の JWT の email で、さらに使う人を絞る（カンマ区切り。空なら Access のポリシーだけで判断する）。
# サービストークンの JWT には email がないため、設定すると拒まれる。そのような相手には MCP_AUTH_TOKEN を使う
# CF_ACCESS_ALLOWED_EMAILS=you@example.com
