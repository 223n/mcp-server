# Copy this file to .env and fill in values for your environment.
# docker-compose.yml が必要な値だけをコンテナに渡します。
OLLAMA_URL=http://host.docker.internal:11434
DEFAULT_MODEL=nucbox-fast:latest
DEEP_MODEL=qwen2.5-coder:14b

# Ollama から何も届かない状態の上限（ミリ秒）。キュー待ち、モデル読み込み、プロンプト評価の時間も含む
OLLAMA_TIMEOUT=300000
# 1 回の生成全体の上限（ミリ秒）
OLLAMA_MAX_DURATION=900000

# HTTP で受け付ける Host / Origin（カンマ区切り）
# ALLOWED_HOSTS=localhost,127.0.0.1,[::1],host.docker.internal,mcp.223n.tech

# HTTP 経由でもファイル読み込みツールを許可する場合だけ true（既定は stdio のみ）
# HTTP_ALLOW_FILES=false

# HTTP の認証（どちらかを設定すると、満たさないリクエストは 401）
# 静的トークン: Authorization: Bearer <MCP_AUTH_TOKEN>
# MCP_AUTH_TOKEN=
# Cloudflare Access の JWT（Cf-Access-Jwt-Assertion）を検証する
# CF_ACCESS_TEAM_DOMAIN=223n.cloudflareaccess.com
# CF_ACCESS_AUD=46e64965fee521bbce471b323fdb211c353f2ad9d630e6ab12a9023fe29e8eb2
